# OpenAI API key — required when embeddings or llm provider is "openai".
# Used by both the local CLI/server and the Docker container (via --env-file .env).
OPENAI_API_KEY=sk-...

# Optional: override the API URL the CLI hits for `pebble ask` and `pebble chat`.
# Default: http://localhost:8000
# PEBBLE_API_URL=http://localhost:8000
